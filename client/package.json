{
  "name": "splitcord-client",
  "private": true,
  "author": "SplitCord-Turkey",
  "version": "1.0.2",
  "description": "SplitCord-Turkey 1.0.2 Installer",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "predist": "dotnet publish ../service/SplitCordService/SplitCordService.csproj -c Release -o ../service/SplitCordService/bin/Release/net8.0-windows/publish",
    "dist": "electron-builder"
  },
  "dependencies": {
    "arrpc": "^3.6.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.16.1"
  },
  "build": {
    "appId": "com.splitcord.turkey",
    "productName": "SplitCord-Turkey",
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "../service/SplitCordService/bin/Release/net8.0-windows/publish",
        "to": "service-installer"
      },
      {
        "from": "../service/installer",
        "to": "service-installer",
        "filter": [
          "*.ps1"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "perMachine": true,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "allowScripts": {
    "electron@44.3.0": true,
    "uiohook-napi@1.5.5": true,
    "electron-winstaller@5.4.0": true
  }
}
