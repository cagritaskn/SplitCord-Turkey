<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- DOĞRULANMADI: bu proje hiç gerçek bir Linux çekirdeğinde derlenip çalıştırılmadı (bkz.
       ../../PORTING_PLAN.md §2 madde 5, D-8). RID/SelfContained ayarları win-x64 karşılığının
       (service/SplitCordService/SplitCordService.csproj) doğrudan Linux karşılığı olarak,
       .NET 8 resmi dokümantasyonuna dayanarak yazıldı. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SplitCordServiceLinux</AssemblyName>
    <RootNamespace>SplitCord.ServiceLinux</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Windows tarafındaki self-contained yayın kararının (bkz. Windows .csproj'daki yorum:
         hedef makinede .NET Runtime kurulu olmasına bağımlı kalmamak için) aynısı Linux için de
         geçerli — bkz. ../../packaging/systemd/ (Faz 6). -->
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsService yerine systemd karşılığı. Paket adı/kullanım şekli .NET 8 resmi
         dokümantasyonuna göre yazıldı, gerçek bir systemd biriminde DOĞRULANMADI. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="8.0.1" />
  </ItemGroup>

  <!-- Windows tarafındaki desenle aynı: linux/scripts/fetch-binaries.js + build-byedpi.sh
       tarafından üretilen binary'ler linux/resources/bin altından servis çıktı dizinindeki
       bin/ altına kopyalanır. -->
  <ItemGroup>
    <Content Include="..\..\resources\bin\**\*" Condition="Exists('..\..\resources\bin')">
      <Link>bin\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
